# Copy this file to .env and fill in your values
# Never commit .env to version control

JWT_SECRET=your_strong_jwt_secret_here

# --- Local Development ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_db_password_here
# DB_NAME=schedula
# DB_SSL=false

# --- Production (Neon PostgreSQL on Render) ---
